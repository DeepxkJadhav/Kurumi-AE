# Copy this file to .env and fill in your own private key.
# Do not commit or share .env.
OPENAI_API_KEY=

# Optional. Leave empty for official OpenAI-compatible defaults.
# For OpenRouter-compatible keys, use:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# Optional chat model for context reactions.
# Official OpenAI example: gpt-4.1-mini
# OpenRouter example: openai/gpt-4o-mini
KURUMI_AE_CHAT_MODEL=

# Optional Windows voice name. Leave empty to auto-pick the first installed female voice.
# Example: Microsoft Zira Desktop
KURUMI_AE_VOICE_NAME=

# Natural non-robotic speech. Uses /audio/speech on an OpenAI-compatible API.
# Requires a provider/key that supports speech generation.
KURUMI_AE_NATURAL_TTS=1
KURUMI_AE_TTS_BASE_URL=https://api.openai.com/v1
KURUMI_AE_TTS_MODEL=gpt-4o-mini-tts
KURUMI_AE_TTS_VOICE=shimmer
